{
  "name": "mystory",
  "version": "1.0.0",
  "description": "My Story - AI 连载小说 App",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "npm run test:fullchain && npm run test:narrative && npm run test:serverless && npm run test:sqlite-memory",
    "test:fullchain": "node tests/fullchain.test.mjs",
    "test:narrative": "node tests/narrative-graph.test.mjs",
    "test:serverless": "node tests/serverless-api.test.mjs",
    "test:sqlite-memory": "node tests/real-sqlite-memory.test.mjs",
    "test:real-7day": "node tests/real-7day-continuity.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
    "pinia": "^2.1.0",
    "puppeteer-core": "^25.3.0",
    "sql.js": "^1.10.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.2.0"
  }
}
