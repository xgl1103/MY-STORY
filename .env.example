# Local demo defaults. Keep false when using the hosted AI endpoint.
VITE_USE_MOCK=false

# Set true in Vercel production to call the serverless /api/ai endpoint.
# Users should then never enter an API key in the browser.
VITE_USE_SERVERLESS_AI=false

# Local testing only. Never paste a real API key into this tracked example file.
VITE_API_KEY=YOUR_API_KEY_HERE
VITE_API_BASE_URL=https://api.deepseek.cn/v1
VITE_API_MODEL=deepseek-v4-flash
